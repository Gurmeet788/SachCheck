# SachCheck Frontend Environment Configuration
# Copy this file to .env to configure your local development environment.

# Toggle Demo Mode vs. Real Backend API
# - Set to 'true' to force demo mode using the dedicated mock service module.
# - Set to 'false' to route verification queries to the real FastAPI backend.
VITE_USE_DEMO=true

# Real Backend API Base URL (FastAPI)
# Ignored when VITE_USE_DEMO=true.
# When VITE_USE_DEMO=false, requests are dispatched to: ${VITE_API_BASE_URL}/verify
# Example: http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api
