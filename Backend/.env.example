# Application Configuration
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security / Secrets
SECRET_KEY=your-secret-key-here

# Database Configuration (PostgreSQL / Supabase with psycopg 3 driver)
# Format: postgresql+psycopg://<db_user>:<db_password>@<db_host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
GOOGLE_FACT_CHECK_API_KEY=your-google-fact-check-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here


